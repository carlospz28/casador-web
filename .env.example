# Copie este archivo como .env.local y llene los valores.
# Sin Supabase la tienda funciona con productos de ejemplo y pedidos solo por WhatsApp.

# URL pública de la tienda (en Vercel: https://su-dominio.com). Sin barra al final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave secreta (service_role). Solo en el servidor; nunca la comparta.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago > Tus integraciones > Credenciales (use las de prueba primero)
MERCADOPAGO_ACCESS_TOKEN=
# Mercado Pago > Webhooks > Clave secreta (opcional; ver README)
MERCADOPAGO_WEBHOOK_SECRET=
